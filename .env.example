# ==============================================================================
# ASH CREATOR STUDIO — Environment Variables Example
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (for YouTube Data & Analytics API)
# Required scopes:
# - https://www.googleapis.com/auth/youtube.readonly
# - https://www.googleapis.com/auth/yt-analytics.readonly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Optional YouTube Data API v3 Public Key
YOUTUBE_API_KEY=your-youtube-api-key
